# Copy to .env and fill in. .env is gitignored; never commit a filled copy. Used on kind only:
# on a real cluster the API key is a Secret (README, "API key").

# The server's API key. Every client sends the same value (xora-sandbox: OPENSANDBOX_SERVER_API_KEY).
OPENSANDBOX_SERVER_API_KEY=change-me-to-a-long-random-string
# The image the smoke test starts. Any image with sh and curl the cluster can pull.
SMOKE_IMAGE=curlimages/curl:8.10.1
