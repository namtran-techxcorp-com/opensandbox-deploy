Changes to the OpenSandbox release-1.1.1 charts (manifests/charts), applied with patch -p1.
The server's RBAC is held to the sandbox namespace, and the controller loses the cluster-wide
Secret read that only snapshots use.

--- a/charts/controller/templates/clusterrole.yaml
+++ b/charts/controller/templates/clusterrole.yaml
@@ -83,14 +83,6 @@
   - list
   - watch
 - apiGroups:
-  - ""
-  resources:
-  - secrets
-  verbs:
-  - get
-  - list
-  - watch
-- apiGroups:
   - batch
   resources:
   - jobs
--- a/charts/server/templates/rbac.yaml
+++ b/charts/server/templates/rbac.yaml
@@ -12,13 +12,17 @@
 # See the License for the specific language governing permissions and
 # limitations under the License.
 
-# Operational RBAC for the server: pods/pvcs/secrets management, CR access,
-# and the binding to the server ServiceAccount.
+# Operational RBAC for the server, held to the sandbox namespace
+# (sandboxNamespace, the [kubernetes] namespace of configToml): pods, pvcs,
+# secrets and CRs there only. The cluster-scoped part is read-only:
+# namespaces and runtimeclasses.
+{{- $sandboxNamespace := required "sandboxNamespace is required" .Values.sandboxNamespace }}
 ---
 apiVersion: {{ include "opensandbox-server.rbac.apiVersion" . }}
-kind: ClusterRole
+kind: Role
 metadata:
   name: {{ include "opensandbox-server.roleName" . }}
+  namespace: {{ $sandboxNamespace }}
   labels:
     {{- include "opensandbox-server.labels" . | nindent 4 }}
 rules:
@@ -26,17 +30,11 @@
     resources: ["pods", "pods/status", "pods/log", "events", "services", "configmaps"]
     verbs: ["create", "delete", "get", "list", "patch", "update", "watch"]
   - apiGroups: [""]
-    resources: ["namespaces"]
-    verbs: ["get", "list"]
-  - apiGroups: [""]
     resources: ["secrets"]
     verbs: ["create", "delete", "get"]
   - apiGroups: [""]
     resources: ["persistentvolumeclaims"]
     verbs: ["create", "delete", "get", "list", "patch"]
-  - apiGroups: ["node.k8s.io"]
-    resources: ["runtimeclasses"]
-    verbs: ["get", "list"]
   - apiGroups: ["sandbox.opensandbox.io"]
     resources: ["batchsandboxes", "batchsandboxes/status", "batchsandboxes/finalizers"]
     verbs: ["create", "delete", "get", "list", "patch", "update", "watch"]
@@ -46,29 +44,54 @@
   - apiGroups: ["sandbox.opensandbox.io"]
     resources: ["sandboxsnapshots", "sandboxsnapshots/status", "sandboxsnapshots/finalizers"]
     verbs: ["create", "delete", "get", "list", "patch", "update", "watch"]
-  # Fsb: Sandbox CR reads power Get/List; SandboxTemplate
-  # CRUD powers the /templates management API; SandboxSnapshot
-  # watches power fsb snapshot status convergence.
+  # The server's informers watch the fast-sandbox kinds whether or not that runtime is used.
   - apiGroups: ["sandbox.fast.io"]
-    resources: ["sandboxes"]
+    resources: ["sandboxes", "sandboxsnapshots"]
     verbs: ["get", "list", "watch"]
   - apiGroups: ["sandbox.fast.io"]
     resources: ["sandboxtemplates"]
     verbs: ["create", "delete", "get", "list", "watch"]
-  - apiGroups: ["sandbox.fast.io"]
-    resources: ["sandboxsnapshots"]
-    verbs: ["get", "list", "watch"]
 ---
 apiVersion: {{ include "opensandbox-server.rbac.apiVersion" . }}
-kind: ClusterRoleBinding
+kind: RoleBinding
 metadata:
